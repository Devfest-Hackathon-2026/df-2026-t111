# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
# .env.local はコミットしないこと（.gitignore 済み）。

# ---- モック API ----
# true のとき、/api/* は Gemini を呼ばずに固定の結果を返す
USE_MOCK_API=true

# ---- Gemini（Vertex AI 経由・サーバー側のみ）----
# ローカルでは `gcloud auth application-default login` で認証する。
# サービスアカウントの鍵（JSON）はリポジトリに置かない。
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=dfhack26-dentou
# 使うモデルが提供されているリージョンを指定する（global なら大半のモデルが使える）
GOOGLE_CLOUD_LOCATION=global
# 使うモデル名（チームで決めて入れる）
GEMINI_MODEL=gemini-2.5-flash

# ---- Firebase（ブラウザで使う値）----
# Firebase コンソール → プロジェクトの設定 → マイアプリ の firebaseConfig から転記する
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dfhack26-dentou
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Google Maps（ブラウザで使う値）----
# Google Cloud コンソールでリファラー制限をかけたキーを使う
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
